{
  "name": "fullstack-monorepo-template",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm -r --stream dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "db:seed": "pnpm --filter backend exec prisma db seed",
    "db:migrate": "pnpm --filter backend exec prisma migrate dev && pnpm db:generate",
    "db:deploy": "pnpm --filter backend exec prisma migrate deploy",
    "db:reset": "pnpm --filter backend exec prisma migrate reset --force && pnpm db:generate && pnpm db:seed",
    "db:generate": "pnpm --filter backend exec prisma generate",
    "db:studio": "pnpm --filter backend exec prisma studio",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "format": "pnpm -r --if-present format",
    "format:check": "pnpm -r --if-present format:check",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm test",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter backend test:integration",
    "start": "pnpm --filter backend start",
    "preview": "pnpm --filter frontend preview",
    "prepare": "husky"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.22.1"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "3.8.1"
  }
}
